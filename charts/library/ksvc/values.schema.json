{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ksvc Helm Chart Values",
  "description": "Schema for ksvc Helm library chart values \u2014 multi-service edition",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nameOverride": {
          "type": "string"
        },
        "fullnameOverride": {
          "type": "string"
        },
        "labels": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuerRef": {
              "$ref": "#/$defs/issuerRef"
            }
          }
        }
      }
    },
    "services": {
      "type": "object",
      "description": "Map of Knative Services. Each key becomes a name suffix: <release-name>-<key>",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/serviceEntry"
      }
    },
    "objectBuckets": {
      "type": "object",
      "description": "Map of ObjectBucketClaim entries. Each key becomes a name suffix: <release-name>-<key>",
      "propertyNames": {
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/objectBucketEntry"
      }
    },
    "kafka": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "provider": {
              "type": "string",
              "enum": [
                "strimzi",
                "redpanda"
              ]
            },
            "name": {
              "type": "string",
              "maxLength": 48
            },
            "replicas": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {
                  "type": "string"
                },
                "storageClassName": {
                  "type": "string"
                }
              }
            },
            "resources": {
              "$ref": "#/$defs/resources"
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "none",
                    "scram"
                  ]
                },
                "username": {
                  "type": "string"
                }
              }
            },
            "topics": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "create": {
                  "type": "boolean"
                },
                "partitions": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "strimzi": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "string"
                },
                "metadataVersion": {
                  "type": "string"
                },
                "extraSpec": {
                  "type": "object"
                },
                "nodePoolExtraSpec": {
                  "type": "object"
                }
              }
            },
            "redpanda": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "extraClusterSpec": {
                  "type": "object"
                },
                "sasl": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "secretRef": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "object",
          "description": "Map of KafkaSource entries. Each key becomes: <release-name>-<key>-kafka-source",
          "additionalProperties": {
            "$ref": "#/$defs/kafkaSourceEntry"
          }
        },
        "broker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "externalTopic": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bootstrapServers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "topicPartitions": {
                  "type": "integer",
                  "minimum": 1
                },
                "topicReplicationFactor": {
                  "type": "integer",
                  "minimum": 1
                },
                "authSecretName": {
                  "type": "string"
                },
                "extra": {
                  "type": "object"
                }
              }
            },
            "delivery": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "retry": {
                  "type": "integer",
                  "minimum": 0
                },
                "backoffPolicy": {
                  "type": "string",
                  "enum": [
                    "linear",
                    "exponential"
                  ]
                },
                "backoffDelay": {
                  "type": "string"
                },
                "deadLetterSink": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "uri": {
                      "type": "string"
                    },
                    "ref": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "apiVersion": {
                          "type": "string"
                        },
                        "kind": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "triggers": {
          "type": "object",
          "description": "Map of Trigger entries. Each key becomes: <release-name>-<key>-trigger",
          "additionalProperties": {
            "$ref": "#/$defs/kafkaTriggerEntry"
          }
        }
      }
    },
    "pingsources": {
      "type": "object",
      "description": "Map of PingSource entries. Each key becomes: <release>-<key>-ping-source",
      "propertyNames": {
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/pingSourceEntry"
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "enum": [
            "14",
            "15",
            "16",
            "17"
          ]
        },
        "instances": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "imageCatalog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["name"]
        },
        "parameters": {
          "type": "object"
        },
        "sharedPreloadLibraries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "postInitSQL": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+[KMGT]i$"
            },
            "storageClassName": {
              "type": "string"
            }
          }
        },
        "pooler": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "instances": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "type": "string",
              "enum": [
                "rw",
                "ro"
              ]
            },
            "poolMode": {
              "type": "string",
              "enum": [
                "transaction",
                "session",
                "statement"
              ]
            },
            "parameters": {
              "type": "object"
            },
            "resources": {
              "$ref": "#/$defs/resources"
            }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "schedule": {
              "type": "string"
            },
            "target": {
              "type": "string",
              "enum": [
                "prefer-standby",
                "primary"
              ]
            },
            "retentionPolicy": {
              "type": "string"
            },
            "objectStore": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "destinationPath": {
                  "type": "string"
                },
                "endpointURL": {
                  "type": "string"
                },
                "bucketRef": {
                  "type": "string",
                  "description": "Key of an objectBuckets entry used to derive the CNPG ObjectStore destinationPath/endpointURL/credentials"
                },
                "s3Credentials": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "secretName": {
                      "type": "string"
                    },
                    "accessKeyIdKey": {
                      "type": "string"
                    },
                    "secretAccessKeyKey": {
                      "type": "string"
                    }
                  }
                },
                "data": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "compression": {
                      "type": "string",
                      "enum": [
                        "gzip",
                        "bzip2",
                        "lz4",
                        "snappy"
                      ]
                    },
                    "jobs": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "wal": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "compression": {
                      "type": "string",
                      "enum": [
                        "gzip",
                        "bzip2",
                        "lz4",
                        "snappy",
                        "zstd",
                        "xz"
                      ]
                    },
                    "maxParallel": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "monitoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "alerts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "replicationLagWarning": {
                  "type": "integer",
                  "minimum": 0
                },
                "replicationLagCritical": {
                  "type": "integer",
                  "minimum": 0
                },
                "highConnectionCount": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuerRef": {
              "$ref": "#/$defs/issuerRef"
            }
          }
        }
      }
    },
    "dragonfly": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "imageTag": {
          "type": "string"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "array"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "passwordFromSecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            },
            "clientCaCertSecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            },
            "certManager": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "issuerRef": {
                  "$ref": "#/$defs/issuerRef"
                },
                "duration": {
                  "type": "string"
                },
                "renewBefore": {
                  "type": "string"
                }
              }
            }
          }
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "cron": {
              "type": "string"
            },
            "enableOnMasterOnly": {
              "type": "boolean"
            },
            "dir": {
              "type": "string"
            },
            "existingPersistentVolumeClaimName": {
              "type": "string"
            },
            "bucketRef": {
              "type": "string",
              "description": "Key of an objectBuckets entry used to derive the Dragonfly S3 snapshot dir/credentials/endpoint"
            },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {
                  "type": "string",
                  "pattern": "^[0-9]+[KMGT]i$"
                },
                "storageClassName": {
                  "type": "string"
                }
              }
            }
          }
        },
        "serviceSpec": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "name": {
              "type": "string"
            },
            "nodePort": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "annotations": {
              "type": "object"
            },
            "labels": {
              "type": "object"
            }
          }
        },
        "pdb": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minAvailable": {
              "type": "integer",
              "minimum": 0
            },
            "maxUnavailable": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "affinity": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "nodeSelector": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "serviceAccountName": {
          "type": "string"
        },
        "priorityClassName": {
          "type": "string"
        }
      }
    },
    "kyverno": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "scaling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "apiVersion": {
              "type": "string",
              "enum": [
                "policies.kyverno.io/v1beta1",
                "policies.kyverno.io/v1"
              ]
            },
            "validationActions": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Deny",
                  "Audit"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      }
    }
  },
  "required": [
    "services"
  ],
  "$defs": {
    "objectBucketEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storageClassName"
      ],
      "properties": {
        "storageClassName": {
          "type": "string",
          "minLength": 1,
          "description": "Name of an existing bucket StorageClass (reference only; never rendered by this chart)"
        },
        "bucketName": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
        },
        "endpointURL": {
          "type": "string",
          "description": "Full URL of the S3/RGW endpoint (CNPG uses it literally; Dragonfly derives host + --s3_use_https)"
        },
        "region": {
          "type": "string",
          "description": "AWS region injected as AWS_REGION for Dragonfly S3 snapshots"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Knative",
            "Deployment"
          ]
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "strategy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxUnavailable": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string"
                }
              ]
            },
            "maxSurge": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string"
                }
              ]
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "preStopSleepSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "serviceConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "sessionAffinity": {
          "type": "string",
          "enum": [
            "None",
            "ClientIP"
          ]
        },
        "sessionAffinityConfig": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clientIP": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "timeoutSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400
                }
              }
            }
          }
        },
        "externalTrafficPolicy": {
          "type": "string",
          "enum": [
            "",
            "Cluster",
            "Local"
          ]
        },
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string"
            }
          ]
        },
        "maxUnavailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "serviceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "properties": {
        "nameOverride": {
          "type": "string",
          "description": "Override the name suffix for this service. When set, replaces the map key in the resource name: <release>-<nameOverride>. Set to empty string to produce just <release> with no suffix."
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "fluxImagePolicy": {
              "type": "string"
            },
            "imagePullSecrets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "scaling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minScale": {
              "type": "integer",
              "minimum": 0
            },
            "maxScale": {
              "type": "integer",
              "minimum": 1
            },
            "target": {
              "type": "integer",
              "minimum": 1
            },
            "containerConcurrency": {
              "type": "integer",
              "minimum": 0
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "class": {
              "type": "string"
            },
            "metric": {
              "type": "string",
              "description": "Metric watched by the Autoscaler: concurrency (default), rps (KPA); cpu, memory, or a custom metric name (HPA class only). Leave empty to use the Knative default (concurrency)."
            }
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "liveness": {
              "$ref": "#/$defs/probe"
            },
            "readiness": {
              "$ref": "#/$defs/probe"
            }
          }
        },
        "env": {
          "type": "array"
        },
        "envFrom": {
          "type": "array"
        },
        "securityContext": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runAsNonRoot": {
              "type": "boolean"
            },
            "runAsUser": {
              "type": "integer"
            },
            "readOnlyRootFilesystem": {
              "type": "boolean"
            },
            "allowPrivilegeEscalation": {
              "type": "boolean"
            },
            "seccompProfile": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "RuntimeDefault",
                    "Localhost",
                    "Unconfined"
                  ]
                },
                "localhostProfile": {
                  "type": "string"
                }
              }
            },
            "capabilities": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "drop": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "add": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "volumeMounts": {
